# Copy to .env and fill in. `make setup` does the copy for you.
#
# THIS FILE IS THE DEVELOPMENT TEMPLATE — every value below is a working local
# default. Deploying for real starts from `deploy/env.prod.example` instead,
# which requires the things this one hands you, and docs/self-hosting.md walks
# through it. The reference below stays complete either way: every optional
# variable the app understands is documented here.
#
# SECRET_KEY and ENCRYPTION_KEY_SALT are mandatory whenever DEBUG is false —
# the settings module refuses to boot without them (SECURITY-BASELINE §8).
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# CORE
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY_SALT=change-me-to-a-different-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000

# Comma-separated https origins to trust for CSRF, e.g. an ngrok tunnel used
# for webhook development. Development settings only.
CSRF_TRUSTED_ORIGINS=

# DATABASE — this URL is for running the app directly on your machine
# (`make server`). The Docker stack ignores it and talks to the `postgres`
# service by name; override that with COMPOSE_DATABASE_URL if you need to.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightbean_chat

# STORAGE — "local" or "s3". The S3_* names are generic on purpose so that
# Cloudflare R2, MinIO and AWS all work with the same variables.
STORAGE_BACKEND=local
# Where uploads land. Leave unset to default to ./media next to manage.py,
# which is what you want when running outside Docker; the compose stack mounts
# a volume at /app/media and sets this itself.
# MEDIA_ROOT=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Serving media from your own domain or a CDN. Leave EMPTY for private
# buckets: django-storages skips the S3 presigner on the custom-domain path,
# so delivery URLs come out unsigned and private objects 403. Set it only for
# public-read buckets, or alongside AWS_CLOUDFRONT_KEY_ID / AWS_CLOUDFRONT_KEY.
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto
# Only needed when S3_CUSTOM_DOMAIN serves a private bucket. Both or neither.
S3_CLOUDFRONT_KEY_ID=
S3_CLOUDFRONT_KEY=

# MEDIA LIBRARY — upload limits, all in bytes. Two independent caps, because
# they stop different things: the per-file ones bound what a single request can
# cost, and the per-workspace one bounds what a member can accumulate over a
# thousand of them. Every value below is the built-in default; uncomment to
# change one.
#
# The accepted types are not configurable and are not meant to be: the upload
# allowlist (images, audio, video, PDF) is decided by sniffing the file's bytes,
# and widening it is a code change with a security review attached.
# MEDIA_MAX_UPLOAD_BYTES_IMAGE=20971520
# MEDIA_MAX_UPLOAD_BYTES_AUDIO=52428800
# MEDIA_MAX_UPLOAD_BYTES_VIDEO=209715200
# MEDIA_MAX_UPLOAD_BYTES_FILE=26214400
# MEDIA_WORKSPACE_QUOTA_BYTES=5368709120
# MEDIA_MAX_FILES_PER_UPLOAD=20
# How many folders one workspace may hold. Nesting is capped at three levels;
# this caps the width. Both the picker payload and the move dropdown render the
# whole set, so the number that keeps those responses small is this one.
# MEDIA_MAX_FOLDERS_PER_WORKSPACE=500
# Refuse to build a thumbnail for an image declaring more pixels than this. A
# 10 KB PNG can claim 60000x60000 and cost gigabytes of RAM to expand.
# MEDIA_MAX_IMAGE_PIXELS=50000000

# AUTHENTICATION — Google SSO is optional. Leave both empty and the sign-in
# page simply shows no Google button; set both to enable it. These are the
# credentials of YOUR Google OAuth client, separate from any PLATFORM_* app.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Which peers may speak for someone else via X-Forwarded-For. Empty means the
# header is ignored entirely, which is the safe default: it is
# attacker-controlled unless a proxy you own wrote it, and trusting it turns the
# auth rate limiting off. Addresses or CIDR ranges, comma-separated. Behind a
# tunnel (ngrok, cloudflared) set 127.0.0.1 to get per-caller buckets back.
TRUSTED_PROXIES=

# PLATFORM APP CREDENTIALS — the deployment-level fallback in the resolution
# chain (workspace override → organization → here). Only the Meta platforms
# have app-level credentials; Telegram bot tokens, Twilio SIDs and SMTP logins
# live on the individual channel connection instead.
#   PLATFORM_<PLATFORM>_<KEY>, e.g.
# PLATFORM_INSTAGRAM_CLIENT_ID=
# PLATFORM_INSTAGRAM_CLIENT_SECRET=
# PLATFORM_MESSENGER_CLIENT_ID=
# PLATFORM_MESSENGER_CLIENT_SECRET=
# PLATFORM_WHATSAPP_CLIENT_ID=
# PLATFORM_WHATSAPP_CLIENT_SECRET=
#
# The same convention carries the token Meta checks when you subscribe a
# webhook URL in the app dashboard. Paste the value you set here into Meta's
# "Verify token" field; a platform with no token set answers 404 to the
# verification GET, so nothing can be subscribed to it by accident.
# PLATFORM_INSTAGRAM_VERIFY_TOKEN=
# PLATFORM_MESSENGER_VERIFY_TOKEN=
# PLATFORM_WHATSAPP_VERIFY_TOKEN=

# WEBHOOK INGESTION — /webhooks/ is the only unauthenticated write path in the
# product, so its limits are tunable without a fork. The defaults suit every
# platform this project speaks to; raise the body cap only if a provider
# genuinely batches more than 256 KB per delivery.
#
# WEBHOOK_MAX_BODY_BYTES=262144
# WEBHOOK_MAX_JSON_DEPTH=20
#
# A correctly configured platform never fails a signature check, so repeated
# failures are either a misconfiguration or someone guessing a secret. After
# WEBHOOK_SIGNATURE_FAILURE_LIMIT failures inside the window, that source (and
# that connection) is refused for WEBHOOK_SIGNATURE_BAN_SECONDS.
# WEBHOOK_SIGNATURE_FAILURE_LIMIT=10
# WEBHOOK_SIGNATURE_FAILURE_WINDOW_SECONDS=300
# WEBHOOK_SIGNATURE_BAN_SECONDS=900
#
# How long raw webhook events are kept. This is also the replay-protection
# window: duplicate delivery is caught by a unique constraint on the event log,
# so an event whose row has been pruned can be replayed with its original
# signature. Shortening it trades storage for that window.
# WEBHOOK_EVENT_LOG_RETENTION_DAYS=30

# EXTERNAL REQUEST (SSRF guard) — the External Request flow node and every
# other server-side fetch of a user-supplied URL go through apps/common/outbound.py.
# Private ranges (10.x, 172.16.x, 192.168.x, fc00::/7) are denied by default.
# Set this only for an on-prem deployment calling services on its own network;
# loopback, 169.254.x (cloud metadata), multicast and this deployment's own
# host stay denied whatever it is set to.
# EXTERNAL_REQUEST_ALLOW_PRIVATE=false
# EXTERNAL_REQUEST_MAX_RESPONSE_BYTES=1048576

# The largest inbound attachment the inbox will fetch and serve back, in bytes.
# Separate from the cap above because a photograph is not a JSON body. Held in
# memory while it is served, so this times the number of concurrent readers is
# memory the web process needs.
# INBOUND_MEDIA_MAX_BYTES=16777216

# PUBLIC API + OUTBOUND WEBHOOKS (SPEC §17) — /api/v1/ authenticates with an
# API key rather than a session, so its limits are tunable without a fork.
# SPEC §17 fixes the rate limit at 10 requests per second per key; the window is
# one second, so a 429 always says Retry-After: 1.
# API_MAX_BODY_BYTES=262144
# API_MAX_JSON_DEPTH=20
# API_RATE_LIMIT_PER_SECOND=10
#
# Failed-bearer throttle, per client address. Checked before the key is hashed,
# so a guessing script does not get to pay only the hash cost per attempt.
# API_AUTH_FAILURE_LIMIT=20
# API_AUTH_FAILURE_WINDOW_SECONDS=300
#
# Outbound webhook deliveries. Every delivery goes through the SSRF guard above,
# so EXTERNAL_REQUEST_ALLOW_PRIVATE also decides whether a webhook may point at
# a private address. A delivery that exhausts its queue retries counts as one
# failure; after API_WEBHOOK_MAX_CONSECUTIVE_FAILURES of them the endpoint is
# switched off and the workspace admins are notified.
# API_WEBHOOK_TIMEOUT_SECONDS=10
# The test button runs in the request, so its deadline is shorter — that is
# time a web worker spends unavailable rather than a queue slot.
# API_WEBHOOK_TEST_TIMEOUT_SECONDS=3
# API_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# API_WEBHOOK_MAX_CONSECUTIVE_FAILURES=100
# API_WEBHOOK_DELIVERY_LOG_KEEP=50

# EMAIL — "smtp" or anything else for the console backend.
#
# Signup sends a verification email, but nothing is ever gated on it
# (ACCOUNT_EMAIL_VERIFICATION = "optional"), so an instance with no SMTP
# configured still works end to end — you just do not get verified addresses,
# and password reset cannot deliver. Configure SMTP for any real deployment.
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# TASK QUEUE — optional. The shared secret for /internal/tick, an HTTP wrapper
# around one worker cycle for hosts with no always-on process: point a cron
# service or uptime pinger at
#   https://your-host/internal/tick?token=<this value>
# every minute and that is your scheduler. Leave it EMPTY (the default) if you
# run `python manage.py process_tasks` — the route 404s when unset, so an
# unconfigured deployment exposes nothing. Generate one the same way as
# SECRET_KEY, and treat it as a credential: anyone holding it can make your web
# process do queue work.
TICK_TOKEN=

# OUTBOUND SEND RATE — optional. Per-platform token buckets (SPEC §8) default to
# the published ceiling for each platform: telegram 25/sec, instagram 8,
# messenger 40, whatsapp 20, sms 1 (per number), email 10. Meta hands those
# limits out per app and per page, so override yours here as JSON if they
# differ. An unknown platform name or a value of zero or less fails a startup
# check rather than being ignored.
# DEFAULT_SEND_RATE_OVERRIDES={"telegram": 10, "sms": 0.5}

# CACHE — optional. Defaults to "dbcache://cache_table", because gunicorn runs
# two workers and a per-process LocMemCache is evaded by landing on the other
# one. The table is created by a migration, so there is nothing extra to run.
# Auth rate limiting has its own table and does not depend on this. No Redis
# (SPEC §2).
# CACHE_URL=

# MONITORING — optional; leave empty to disable Sentry entirely
SENTRY_DSN=
