# Turn EBADENGINE from a warning into an install failure. Without this, a
# dependency that declares it needs a newer Node than this project targets
# installs anyway and fails later as an unexplained crash at runtime rather
# than as a failed install.
#
# The Node version itself lives in .nvmrc (which CI reads) and in package.json's
# `engines` block, which is what this setting enforces.
engine-strict=true
