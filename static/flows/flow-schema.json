{
  "$defs": {
    "action_add_tag": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "verb": {
          "const": "add_tag",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "tag"
      ],
      "type": "object"
    },
    "action_assign_conversation": {
      "additionalProperties": false,
      "properties": {
        "member": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "verb": {
          "const": "assign_conversation",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "member"
      ],
      "type": "object"
    },
    "action_clear_field": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "verb": {
          "const": "clear_field",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "field"
      ],
      "type": "object"
    },
    "action_close_conversation": {
      "additionalProperties": false,
      "properties": {
        "verb": {
          "const": "close_conversation",
          "type": "string"
        }
      },
      "required": [
        "verb"
      ],
      "type": "object"
    },
    "action_notify_members": {
      "additionalProperties": false,
      "properties": {
        "member_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "verb": {
          "const": "notify_members",
          "type": "string"
        },
        "via": {
          "enum": [
            "in_app",
            "email"
          ],
          "type": "string"
        }
      },
      "required": [
        "verb",
        "member_ids",
        "via",
        "text"
      ],
      "type": "object"
    },
    "action_open_conversation": {
      "additionalProperties": false,
      "properties": {
        "verb": {
          "const": "open_conversation",
          "type": "string"
        }
      },
      "required": [
        "verb"
      ],
      "type": "object"
    },
    "action_remove_tag": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "verb": {
          "const": "remove_tag",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "tag"
      ],
      "type": "object"
    },
    "action_set_field": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "description": "May carry {{placeholders}} (SECURITY-BASELINE §3).",
          "maxLength": 4096,
          "type": "string"
        },
        "verb": {
          "const": "set_field",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "field",
        "value"
      ],
      "type": "object"
    },
    "action_step": {
      "discriminator": {
        "mapping": {
          "add_tag": "#/$defs/action_add_tag",
          "assign_conversation": "#/$defs/action_assign_conversation",
          "clear_field": "#/$defs/action_clear_field",
          "close_conversation": "#/$defs/action_close_conversation",
          "notify_members": "#/$defs/action_notify_members",
          "open_conversation": "#/$defs/action_open_conversation",
          "remove_tag": "#/$defs/action_remove_tag",
          "set_field": "#/$defs/action_set_field",
          "subscribe_sequence": "#/$defs/action_subscribe_sequence",
          "unsubscribe_sequence": "#/$defs/action_unsubscribe_sequence"
        },
        "propertyName": "verb"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/action_add_tag"
        },
        {
          "$ref": "#/$defs/action_remove_tag"
        },
        {
          "$ref": "#/$defs/action_set_field"
        },
        {
          "$ref": "#/$defs/action_clear_field"
        },
        {
          "$ref": "#/$defs/action_subscribe_sequence"
        },
        {
          "$ref": "#/$defs/action_unsubscribe_sequence"
        },
        {
          "$ref": "#/$defs/action_open_conversation"
        },
        {
          "$ref": "#/$defs/action_close_conversation"
        },
        {
          "$ref": "#/$defs/action_assign_conversation"
        },
        {
          "$ref": "#/$defs/action_notify_members"
        }
      ],
      "type": "object"
    },
    "action_subscribe_sequence": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "verb": {
          "const": "subscribe_sequence",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "sequence"
      ],
      "type": "object"
    },
    "action_unsubscribe_sequence": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "verb": {
          "const": "unsubscribe_sequence",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "sequence"
      ],
      "type": "object"
    },
    "block_card": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "Media library id or URL.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "subtitle": {
          "maxLength": 400,
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "card",
          "type": "string"
        },
        "url_button": {
          "$ref": "#/$defs/url_button"
        }
      },
      "required": [
        "type",
        "title"
      ],
      "type": "object"
    },
    "block_gallery": {
      "additionalProperties": false,
      "properties": {
        "cards": {
          "items": {
            "$ref": "#/$defs/gallery_card"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "const": "gallery",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cards"
      ],
      "type": "object"
    },
    "block_media": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "media_id"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "caption": {
          "maxLength": 1024,
          "type": "string"
        },
        "media_id": {
          "description": "Media library asset id (#16).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "image",
            "audio",
            "video",
            "file"
          ],
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "block_text": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "type": "object"
    },
    "condition_filter": {
      "additionalProperties": false,
      "description": "SPEC §11.4. Vendored form, in force only until apps.contacts.conditions (issue #3) is importable; see apps/flows/schema/condition.py.",
      "properties": {
        "match": {
          "description": "Whether every rule must hold, or any one of them.",
          "enum": [
            "all",
            "any"
          ],
          "type": "string"
        },
        "rules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "What the rule is about: a tag name, a custom-field name, a system field, a segment id. Omitted for sources that need no key, such as window.",
                "maxLength": 200,
                "type": "string"
              },
              "op": {
                "description": "Operators by value type — text: is, is_not, contains, has_value, no_value; number: =, !=, >, <, >=, <=; date/datetime: before, after, on, days_ago, days_from_now; boolean: is; tag: has, has_not; sequence: subscribed, not_subscribed; window: inside, outside.",
                "enum": [
                  "is",
                  "is_not",
                  "contains",
                  "has_value",
                  "no_value",
                  "=",
                  "!=",
                  ">",
                  "<",
                  ">=",
                  "<=",
                  "before",
                  "after",
                  "on",
                  "days_ago",
                  "days_from_now",
                  "has",
                  "has_not",
                  "subscribed",
                  "not_subscribed",
                  "inside",
                  "outside"
                ],
                "type": "string"
              },
              "source": {
                "enum": [
                  "tag",
                  "custom_field",
                  "system_field",
                  "segment",
                  "sequence",
                  "window"
                ],
                "type": "string"
              },
              "value": {
                "description": "Absent for the operators that take no operand (has_value, no_value, has).",
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "source",
              "op"
            ],
            "type": "object"
          },
          "maxItems": 50,
          "type": "array"
        }
      },
      "required": [
        "match",
        "rules"
      ],
      "title": "Condition filter",
      "type": "object"
    },
    "continue_window": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "description": "Local time, HH:MM.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "to": {
          "description": "Local time, HH:MM.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "use_contact_timezone": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "source": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "sourceHandle": {
          "description": "default | btn:<id> | qr:<id> | cond:true | cond:false | rand:<id> | timeout | error",
          "maxLength": 70,
          "minLength": 1,
          "pattern": "^(?:default|timeout|error|cond:(?:true|false)|(?:btn|qr|rand):[A-Za-z0-9_-]{1,64})$",
          "type": "string"
        },
        "target": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "sourceHandle",
        "target"
      ],
      "type": "object"
    },
    "followup": {
      "additionalProperties": false,
      "description": "Routes to the `timeout` handle when the wait expires (SPEC §11.1).",
      "properties": {
        "delay": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "unit": {
          "enum": [
            "minutes",
            "hours",
            "days"
          ],
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "gallery_card": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "Media library id or URL.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "subtitle": {
          "maxLength": 400,
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "url_button": {
          "$ref": "#/$defs/url_button"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "http_header": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "message_block": {
      "discriminator": {
        "mapping": {
          "audio": "#/$defs/block_media",
          "card": "#/$defs/block_card",
          "file": "#/$defs/block_media",
          "gallery": "#/$defs/block_gallery",
          "image": "#/$defs/block_media",
          "text": "#/$defs/block_text",
          "video": "#/$defs/block_media"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/block_text"
        },
        {
          "$ref": "#/$defs/block_media"
        },
        {
          "$ref": "#/$defs/block_card"
        },
        {
          "$ref": "#/$defs/block_gallery"
        }
      ],
      "type": "object"
    },
    "message_button": {
      "discriminator": {
        "mapping": {
          "postback": "#/$defs/message_button_postback",
          "url": "#/$defs/message_button_url"
        },
        "propertyName": "action"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/message_button_url"
        },
        {
          "$ref": "#/$defs/message_button_postback"
        }
      ],
      "type": "object"
    },
    "message_button_postback": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "postback",
          "type": "string"
        },
        "id": {
          "description": "The id in this button's btn:<id> handle.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "action"
      ],
      "type": "object"
    },
    "message_button_url": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "url",
          "type": "string"
        },
        "id": {
          "description": "The id in this button's btn:<id> handle.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "action",
        "url"
      ],
      "type": "object"
    },
    "node": {
      "discriminator": {
        "mapping": {
          "action": "#/$defs/node_action",
          "condition": "#/$defs/node_condition",
          "data_collection": "#/$defs/node_data_collection",
          "external_request": "#/$defs/node_external_request",
          "note": "#/$defs/node_note",
          "randomizer": "#/$defs/node_randomizer",
          "send_email": "#/$defs/node_send_email",
          "send_message": "#/$defs/node_send_message",
          "send_sms": "#/$defs/node_send_sms",
          "smart_delay": "#/$defs/node_smart_delay",
          "start_flow": "#/$defs/node_start_flow"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/node_send_message"
        },
        {
          "$ref": "#/$defs/node_action"
        },
        {
          "$ref": "#/$defs/node_start_flow"
        },
        {
          "$ref": "#/$defs/node_condition"
        },
        {
          "$ref": "#/$defs/node_smart_delay"
        },
        {
          "$ref": "#/$defs/node_randomizer"
        },
        {
          "$ref": "#/$defs/node_external_request"
        },
        {
          "$ref": "#/$defs/node_data_collection"
        },
        {
          "$ref": "#/$defs/node_send_sms"
        },
        {
          "$ref": "#/$defs/node_send_email"
        },
        {
          "$ref": "#/$defs/node_note"
        }
      ],
      "type": "object"
    },
    "node_action": {
      "additionalProperties": false,
      "description": "SPEC §11.2. Runs its verbs in order and always continues.",
      "properties": {
        "config": {
          "additionalProperties": false,
          "properties": {
            "actions": {
              "items": {
                "$ref": "#/$defs/action_step"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "actions"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "type": {
          "const": "action",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "position",
        "config"
      ],
      "type": "object"
    },
    "node_condition": {
      "additionalProperties": false,
      "description": "SPEC §11.4. The filter is contract 8's CONDITION_SCHEMA, embedded, not re-declared.",
      "properties": {
        "config": {
          "$ref": "#/$defs/condition_filter"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "type": {
          "const": "condition",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "position",
        "config"
      ],
      "type": "object"
    },
    "node_data_collection": {
      "additionalProperties": false,
      "description": "SPEC §11.8. Validated reply capture; email/phone answers also record consent.",
      "properties": {
        "config": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "reply_type": {
              "enum": [
                "text",
                "email",
                "phone",
                "number",
                "date",
                "url"
              ],
              "type": "string"
            },
            "retry": {
              "additionalProperties": false,
              "properties": {
                "invalid_text": {
                  "maxLength": 1024,
                  "type": "string"
                },
                "max": {
                  "maximum": 3,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "target": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "custom_field",
                    "system_field"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "type",
                "key"
              ],
              "type": "object"
            },
            "timeout": {
              "additionalProperties": false,
              "properties": {
                "delay": {
                  "maximum": 10000,
                  "minimum": 1,
                  "type": "integer"
                },
                "enabled": {
                  "type": "boolean"
                },
                "unit": {
                  "enum": [
                    "minutes",
                    "hours",
                    "days"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "enabled"
              ],
              "type": "object"
            }
          },
          "required": [
            "question",
            "reply_type",
            "target"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "type": {
          "const": "data_collection",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "position",
        "config"
      ],
      "type": "object"
    },
    "node_external_request": {
      "additionalProperties": false,
      "description": "SPEC §11.7. Runtime is L4-E and goes through the shared SSRF guard (SECURITY-BASELINE §6); nothing in this app fetches the URL.",
      "properties": {
        "config": {
          "additionalProperties": false,
          "properties": {
            "body": {
              "description": "JSON body template; placeholders are substituted, never evaluated."
            },
            "fallback_handle_on_error": {
              "type": "boolean"
            },
            "headers": {
              "items": {
                "$ref": "#/$defs/http_header"
              },
              "maxItems": 20,
              "type": "array"
            },
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ],
              "type": "string"
            },
            "response_mappings": {
              "items": {
                "$ref": "#/$defs/response_mapping"
              },
              "maxItems": 20,
              "type": "array"
            },
            "timeout_s": {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "url": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "method",
            "url"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
