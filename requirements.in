# Runtime dependencies for BrightBean Chat.
#
# This file lists DIRECT dependencies and is the one humans edit. What gets
# installed is requirements.txt, compiled from this file by `make lock`: the
# full transitive tree, pinned and hashed. This is the pip-tools layout, which
# is also the one Dependabot understands — it bumps the .in and recompiles the
# .txt in the same PR.
#
# A version pin names an artefact; it does not verify one, and it says nothing
# about transitive dependencies. `pip install --require-hashes -r
# requirements.txt` gives both (SECURITY-BASELINE §10 — supply chain).
#
# Exact pins, not ranges. Studio uses ranges and its own requirements.txt
# documents the consequence: CI resolves the newest match while local
# environments sit on an older one, so a release broke 509 tests in CI that
# passed locally. Dependabot (.github/dependabot.yml) moves these forward; run
# `make lock` and commit the result whenever they change.
#
# Development and test tooling lives in requirements-dev.in so the runtime
# image does not ship pytest, ruff and mypy.

# Core
Django==5.2.17            # 5.2 is the LTS line (security fixes through Apr 2028)
django-environ==0.14.0
psycopg[binary]==3.3.4     # psycopg 3; Postgres is the only datastore (SPEC §2)
gunicorn==26.1.0

# Security
django-csp==4.0            # 4.x dict-form config; see config/settings/base.py
cryptography==50.0.0       # AES-256-GCM + HKDF for apps/common/encryption.py

# Platform HTTP (channel adapters — apps/channels/providers/base.py)
# Direct dependency of the adapter base: timeouts, 429 handling and error
# mapping are shared by every Layer-4/5 adapter, which is what makes contract 4's
# "one module and one registry line" per platform true. Its MockTransport is
# also what lets that policy be tested without a network.
httpx==0.28.1

# Static files
whitenoise==6.12.0

# Storage (local disk or any S3-compatible endpoint, incl. Cloudflare R2)
django-storages[s3]==1.14.6

# Media library thumbnails (issue #16). Only the image path uses it; there is
# deliberately no ffmpeg dependency, so video thumbnails and duration are not
# extracted.
Pillow==12.3.0

# Amazon SES, for the email channel's SES backend (issue #21). Already present
# transitively via django-storages[s3]; named here because apps/channels/providers/
# email_backends.py imports it directly, and an undeclared direct import is one
# `django-storages` release away from vanishing. The import is deferred inside
# the one function that builds a client, so an SMTP-only or Resend-only
# deployment never loads botocore.
boto3==1.43.76

# Monitoring (inert unless SENTRY_DSN is set)
sentry-sdk[django]==2.68.0

# Auth
django-allauth[socialaccount]==65.19.1   # 65.x API: ACCOUNT_LOGIN_METHODS / ACCOUNT_SIGNUP_FIELDS
bcrypt==5.0.0             # BCryptSHA256PasswordHasher's runtime dep; Django does not declare it

# QR codes for ref-URL triggers (issue #11, SPEC §21 phase 2). Pure Python with
# no runtime dependencies on 3.12, and it renders SVG without Pillow — the QR
# has to be generated locally because SPEC forbids handing a workspace's deep
# link to an external image service.
segno==1.6.6
