#: apps/flows/portability/library.py:167 apps/flows/portability/library.py:189
#: apps/flows/portability/library.py:245 apps/flows/portability/library.py:344
#: apps/flows/portability/library.py:359 apps/flows/portability/library.py:379
msgid "Starters"
msgstr "Баштоо"

#: apps/flows/portability/library.py:174 apps/flows/portability/library.py:213
#: apps/flows/portability/library.py:262 apps/flows/portability/library.py:269
#: apps/flows/portability/library.py:289 apps/flows/portability/library.py:299
#: apps/flows/portability/library.py:304 apps/flows/portability/library.py:314
#: apps/flows/portability/library.py:384
msgid "Grow"
msgstr "Өсүү"

#: apps/flows/portability/library.py:175
msgid "Ask for an email address"
msgstr "Email дарегин суроо"

#: apps/flows/portability/library.py:176
msgid ""
"Asks for an email address, checks it looks real, and saves it to the contact "
"before replying."
msgstr ""
"Email дарегин сурайт, анын чын экенин текшерет жана жооп бергенге чейин аны "
"контактка сактайт."

#: apps/flows/portability/library.py:179 apps/flows/portability/library.py:184
#: apps/flows/portability/library.py:201 apps/flows/portability/library.py:250
#: apps/flows/portability/library.py:274 apps/flows/portability/library.py:279
#: apps/flows/portability/library.py:284 apps/flows/portability/library.py:294
#: apps/flows/portability/library.py:324 apps/flows/portability/library.py:329
#: apps/flows/portability/library.py:349 apps/flows/portability/library.py:354
#: apps/flows/portability/library.py:364 apps/flows/portability/library.py:374
#: apps/flows/portability/library.py:389 apps/flows/portability/library.py:394
msgid "Engage"
msgstr "Тартылуу"

#: apps/flows/portability/library.py:180
msgid "Remind people about an event"
msgstr "Иш-чара тууралуу эскертүү"

#: apps/flows/portability/library.py:181
msgid ""
"Signs someone up for an event over Telegram, then messages them again nearer "
"the time."
msgstr ""
"Адамды Telegram аркылуу иш-чарага жаздырат, андан кийин күнү жакындаганда "
"кайра жазат."

#: apps/flows/portability/library.py:185
msgid "Ask how it went after a purchase"
msgstr "Сатып алуудан кийин пикир суроо"

#: apps/flows/portability/library.py:186
msgid ""
"Waits until the order has landed, asks how it went, and routes the answer by "
"what they say."
msgstr ""
"Буйрутма жеткирилгенче күтөт, кандай болгонун сурайт жана жоопко жараша "
"багыттайт."

#: apps/flows/portability/library.py:190
msgid "Welcome someone new"
msgstr "Жаңы адамды тосуп алуу"

#: apps/flows/portability/library.py:191
msgid ""
"The first thing a new Telegram contact hears, with a follow-up a little "
"later."
msgstr ""
"Telegram'дагы жаңы контакт биринчи угар нерсе, бир аздан кийин кайра жазуу "
"менен."

#: apps/flows/portability/library.py:194 apps/flows/portability/library.py:206
#: apps/flows/portability/library.py:218 apps/flows/portability/library.py:223
#: apps/flows/portability/library.py:228 apps/flows/portability/library.py:233
#: apps/flows/portability/library.py:240 apps/flows/portability/library.py:257
#: apps/flows/portability/library.py:309 apps/flows/portability/library.py:319
#: apps/flows/portability/library.py:334 apps/flows/portability/library.py:339
#: apps/flows/portability/library.py:369
msgid "Convert"
msgstr "Сатуу"

#: apps/flows/portability/library.py:195
msgid "Follow up an enquiry that went quiet"
msgstr "Унутулган суроого эскертүү"

#: apps/flows/portability/library.py:197
msgid ""
"Chases an enquiry that went quiet twice, spaced out, then tags it so you can "
"see who never replied."
msgstr ""
"Унутулган суроого эки жолу, аралык менен эскертет, андан кийин ким жооп "
"бербегенин көрүү үчүн тег коёт."

#: apps/flows/portability/library.py:202
msgid "Hand over to a person"
msgstr "Диалогду адамга өткөрүп берүү"

#: apps/flows/portability/library.py:203
msgid ""
"Takes the conversation off automation and assigns it to a teammate, with a "
"note saying why."
msgstr ""
"Диалогду автоматтан алып, кесиптешке дайындайт, себебин жазган белги менен."

#: apps/flows/portability/library.py:207
msgid "Affiliate picks from comments"
msgstr "Комментарийлерден туунду тандоолор"

#: apps/flows/portability/library.py:209
msgid ""
"A comment on the post sends a swipeable gallery of your affiliate picks, "
"each card linking straight out."
msgstr ""
"Посттогу комментарий туунду товарлардын сүрөт галереясын жөнөтөт, ар бир "
"карточка түз шилтемеге алып барат."

#: apps/flows/portability/library.py:214
msgid "Follow to unlock"
msgstr "Ачуу үчүн жазылуу"

#: apps/flows/portability/library.py:215
msgid ""
"Ask for the follow before you hand over the freebie, then tag whoever "
"confirms."
msgstr ""
"Акысыз нерсени бергенче жазылууну сурайт, андан кийин ырастагандарга тег "
"коёт."

#: apps/flows/portability/library.py:219
msgid "Auto-DM the link from comments"
msgstr "Комментарийден шилтемени DM аркылуу жөнөтүү"

#: apps/flows/portability/library.py:220
msgid ""
"Someone comments, you reply publicly and DM them the link. The classic "
"comment-to-DM."
msgstr ""
"Бирөө комментарий жазат, сиз ачык жооп бересиз жана шилтемени DM аркылуу "
"жөнөтөсүз. Классикалык комментарийден DM'ге өтүү."

#: apps/flows/portability/library.py:224
msgid "Product lineup in DMs"
msgstr "DM'де товарлар тизмеси"

#: apps/flows/portability/library.py:225
msgid ""
"Send the whole lineup as a gallery, then answer the two questions that stop "
"a sale."
msgstr ""
"Бүт тизмени галерея түрүндө жөнөтөт, андан кийин сатууга тоскоол болгон эки "
"суроого жооп берет."

#: apps/flows/portability/library.py:229
msgid "Sell from Reel comments"
msgstr "Reel комментарийлеринен сатуу"

#: apps/flows/portability/library.py:230
msgid "A Reel got people asking. DM them the product and tag the interest."
msgstr ""
"Reel адамдарды кызыктырды. Товарды DM аркылуу жөнөтүп, кызыгууну тег менен "
"белгилеңиз."

#: apps/flows/portability/library.py:234
msgid "Comments into RSVPs"
msgstr "Комментарийлерди ырастоого айландыруу"

#: apps/flows/portability/library.py:236
msgid ""
"Turn “comment to join” into a confirmed RSVP with a calendar link and a tag "
"to broadcast to later."
msgstr ""
"«Катышуу үчүн комментарий жаз» дегенди күнтизбе шилтемеси менен ырасталган "
"катышууга айландырат, кийинки таратуу үчүн тег коёт."

#: apps/flows/portability/library.py:241
msgid "Comment for a discount code"
msgstr "Комментарий үчүн арзандатуу коду"

#: apps/flows/portability/library.py:242
msgid ""
"A comment sends the discount code by DM, then follows up in case it went "
"unused."
msgstr ""
"Комментарий арзандатуу кодун DM аркылуу жөнөтөт, андан кийин колдонулбаса "
"эскертет."

#: apps/flows/portability/library.py:246
msgid "Comment-to-DM lead magnet"
msgstr "Комментарийден DM'ге лид-магнит"

#: apps/flows/portability/library.py:247
msgid ""
"Comment-triggered DM that delivers a guide and collects an email address."
msgstr "Комментарий менен иштелген DM гид жөнөтөт жана email дарегин чогултат."

#: apps/flows/portability/library.py:251
msgid "Respond to every DM"
msgstr "Ар бир DM'ге жооп берүү"

#: apps/flows/portability/library.py:253
msgid ""
"Catch every DM nothing else answered, greet people by name and route them to "
"buy, ask or reach a person."
msgstr ""
"Эч ким жооп бербеген ар бир DM'ди кармайт, атын атап саламдашат жана сатып "
"алуу, суроо же адамга жетүү багытына багыттайт."

#: apps/flows/portability/library.py:258
msgid "Early access to the launch"
msgstr "Чыгарууга эрте мүмкүнчүлүк"

#: apps/flows/portability/library.py:259
msgid ""
"A keyword puts people on the launch waitlist and tags them for the broadcast "
"on the day."
msgstr ""
"Ачкыч сөз адамды жайылтуу тизмесине кошот жана күнү таратуу үчүн тег коёт."

#: apps/flows/portability/library.py:263
msgid "Move the conversation to SMS"
msgstr "Маекти SMS'ке которуу"

#: apps/flows/portability/library.py:265
msgid ""
"Move the conversation to SMS before Instagram's 24-hour window closes, with "
"a DM fallback if the text fails."
msgstr ""
"Instagram'дын 24 сааттык терезеси жабылганга чейин маекти SMS'ке которот, "
"билдирүү өтпөй калса DM'ге кайтарат."

#: apps/flows/portability/library.py:270
msgid "Grow the email list"
msgstr "Email тизмесин өстүрүү"

#: apps/flows/portability/library.py:271
msgid ""
"Trade a download for an email address. The answer records consent alongside "
"it."
msgstr "Жүктөлмөнү email дарегине алмаштырат. Жооп макулдукту да чогуу жазат."

#: apps/flows/portability/library.py:275
msgid "Answer the usual questions"
msgstr "Көп берилүүчү суроолорго жооп берүү"

#: apps/flows/portability/library.py:276
msgid "One keyword, one hub, four answers, and a way through to a person."
msgstr "Бир ачкыч сөз, бир хаб, төрт жооп жана адамга жетүүчү жол."

#: apps/flows/portability/library.py:280
msgid "Drop the link in DMs"
msgstr "DM'ге шилтеме таштоо"

#: apps/flows/portability/library.py:281
msgid "The simplest one: a keyword in the DM, the link straight back."
msgstr "Эң жөнөкөйү: DM'де ачкыч сөз — жооп түрүндө түз эле шилтеме."

#: apps/flows/portability/library.py:285
msgid "Qualify with a quiz"
msgstr "Тест менен тандоо"

#: apps/flows/portability/library.py:286
msgid ""
"Two questions that tag people by where they are, then send each group a "
"different offer."
msgstr ""
"Эки суроо адамды кайда экенине жараша тег менен белгилейт, андан кийин ар "
"бир топко башка сунуш жөнөтөт."

#: apps/flows/portability/library.py:290
msgid "Grow the SMS list"
msgstr "SMS тизмесин өстүрүү"

#: apps/flows/portability/library.py:291
msgid "Collect phone numbers with the consent wording the SMS rules expect."
msgstr ""
"SMS эрежелери талап кылган макулдук сөздөрү менен телефон номерлерин "
"чогултат."

#: apps/flows/portability/library.py:295
msgid "Answer 'where is this from?'"
msgstr "«Бул кайдан?» деген суроого жооп берүү"

#: apps/flows/portability/library.py:296
msgid ""
"Answer “where is this from?” the moment it lands, with the product and a "
"link."
msgstr ""
"«Бул кайдан?» дегенге дароо жооп берет, товар менен шилтемени кошо жиберет."

#: apps/flows/portability/library.py:300
msgid "Send people to YouTube"
msgstr "YouTube'ка жиберүү"

#: apps/flows/portability/library.py:301
msgid "Send your Instagram audience to the long version on YouTube."
msgstr "Instagram аудиториясын YouTube'дагы толук версияга жиберет."

#: apps/flows/portability/library.py:305
msgid "Link in bio opens a chat"
msgstr "Профилдеги шилтеме маекти ачат"

#: apps/flows/portability/library.py:306
msgid ""
"The link in your bio opens a chat that already knows where they came from."
msgstr "Профилдеги шилтеме адам кайдан келгенин билген маекти ачат."

#: apps/flows/portability/library.py:310
msgid "Answer price questions on Instagram"
msgstr "Баа тууралуу суроолорго жооп берүү"

#: apps/flows/portability/library.py:311
msgid ""
"Answers “how much?” in the comments by DM, and asks what they are after "
"before quoting."
msgstr ""
"Комментарийлердеги «канча турат?» деген суроого DM аркылуу жооп берет, баа "
"айтаардан мурун эмне керек экенин сурайт."

#: apps/flows/portability/library.py:315
msgid "Sort collab requests from Stories"
msgstr "Коллаборация сурамдарын иргөө"

#: apps/flows/portability/library.py:316
msgid ""
"Sort collab replies into brands and creators, capture a brief and tag the "
"request."
msgstr ""
"Коллаборация жоопторун бренддер жана авторлор боюнча иргейт, брифти чогултат "
"жана сурамга тег коёт."

#: apps/flows/portability/library.py:320
msgid "Limited-time offer from Stories"
msgstr "Историялардан убактылуу сунуш"

#: apps/flows/portability/library.py:321
msgid ""
"Send the code from your Story, then nudge once before the window closes."
msgstr ""
"Кодду историядан жөнөтөт, андан кийин мөөнөт бүтөрдөн мурун бир жолу "
"эскертет."

#: apps/flows/portability/library.py:325
msgid "Thank someone for a story mention"
msgstr "Историядагы белгилегени үчүн ыраазычылык"

#: apps/flows/portability/library.py:326
msgid ""
"Thanks somebody who mentioned you in a story, and comes back later with an "
"offer."
msgstr ""
"Историяда сизди белгилеген адамга ыраазычылык билдирет, кийинчерээк сунуш "
"менен кайра кайрылат."

#: apps/flows/portability/library.py:330
msgid "Story reply starts a conversation"
msgstr "Историяга жооп маекти баштайт"

#: apps/flows/portability/library.py:331
msgid ""
"Turns a story reply into a real conversation instead of a notification you "
"never answer."
msgstr ""
"Историяга жоопту эч качан жооп бербеген эскертменин ордуна чыныгы маекке "
"айландырат."

#: apps/flows/portability/library.py:335
msgid "Reply to a Facebook comment privately"
msgstr "Facebook комментарийине жеке жооп берүү"

#: apps/flows/portability/library.py:336
msgid ""
"Replies to a Facebook comment privately, which is the reply that can "
"actually ask for something."
msgstr ""
"Facebook комментарийине жеке жооп берет — бул чындап эле бир нерсе сурай "
"турган жооп."

#: apps/flows/portability/library.py:340
msgid "Collect the details for a quote"
msgstr "Баа эсептөө үчүн маалымат чогултуу"

#: apps/flows/portability/library.py:341
msgid ""
"Collects the three details you need to quote, one question at a time, and "
"saves each one."
msgstr ""
"Баа эсептөө үчүн керектүү үч маалыматты бир сурам менен чогултат жана ар "
"бирин сактайт."

#: apps/flows/portability/library.py:345
msgid "Messenger welcome"
msgstr "Messenger'де тосуп алуу"

#: apps/flows/portability/library.py:346
msgid ""
"What a first-time Messenger contact hears, in four short messages rather "
"than one wall."
msgstr ""
"Messenger'ге биринчи жолу жазган адам угар нерсе — бир дубалдын ордуна төрт "
"кыска билдирүү менен."

#: apps/flows/portability/library.py:350
msgid "Reply outside opening hours"
msgstr "Жумуш убактысынан тышкары жооп"

#: apps/flows/portability/library.py:351
msgid ""
"Answers outside opening hours with when you are next open, so nobody is left "
"waiting."
msgstr ""
"Жумуш убактысынан тышкары качан байланышка чыгаарыңызды айтып жооп берет, эч "
"ким күтпөйт."

#: apps/flows/portability/library.py:355
msgid "Remind someone of an appointment"
msgstr "Жолугушуу тууралуу эскертүү"

#: apps/flows/portability/library.py:356
msgid "Texts a reminder before the appointment, and again when it is close."
msgstr ""
"Жолугушуудан мурун SMS жөнөтөт, андан кийин убакыт жакындаганда дагы бир "
"жолу."

#: apps/flows/portability/library.py:360
msgid "SMS keyword opt-in"
msgstr "SMS ачкыч сөз аркылуу жазылуу"

#: apps/flows/portability/library.py:361
msgid "Keyword opt-in over SMS that records consent and tags the subscriber."
msgstr ""
"SMS аркылуу ачкыч сөз менен жазылуу, макулдукту жазат жана жазылуучуга тег "
"коёт."

#: apps/flows/portability/library.py:365
msgid "Ask for a review"
msgstr "Пикир суроо"

#: apps/flows/portability/library.py:366
msgid ""
"Waits a few days, asks for a review, and stops asking the people who already "
"left one."
msgstr ""
"Бир нече күн күтөт, пикир калтырууну сурайт жана мурун калтыргандардан "
"сурабай коёт."

#: apps/flows/portability/library.py:370
msgid "Take a booking enquiry"
msgstr "Брондоо сурамын кабыл алуу"

#: apps/flows/portability/library.py:371
msgid ""
"Takes a booking enquiry over Telegram and saves the date, the size and the "
"contact."
msgstr ""
"Telegram аркылуу брондоо сурамын кабыл алат, күнүн, өлчөмүн жана байланышын "
"сактайт."

#: apps/flows/portability/library.py:375
msgid "Sort support messages"
msgstr "Колдоо билдирүүлөрүн иргөө"

#: apps/flows/portability/library.py:376
msgid ""
"Sorts an incoming support message into the right queue and tags it for "
"whoever picks it up."
msgstr ""
"Келген колдоо билдирүүсүн керектүү кезекке иргейт жана аны кабыл алуучуга "
"тег коёт."

#: apps/flows/portability/library.py:380
msgid "Telegram welcome and FAQ"
msgstr "Telegram'да тосуп алуу жана көп берилүүчү суроолор"

#: apps/flows/portability/library.py:381
msgid ""
"Telegram welcome message with a three-way FAQ menu behind quick replies."
msgstr ""
"Тез жооптордун артында үч тармактуу суроо-жооп менюсу бар Telegram тосуп "
"алуу билдирүүсү."

#: apps/flows/portability/library.py:385
msgid "Join a waitlist"
msgstr "Күтүү тизмесине жазылуу"

#: apps/flows/portability/library.py:386
msgid ""
"Collects an email for the waitlist and tags the person so you can message "
"the list later."
msgstr ""
"Күтүү тизмеси үчүн email чогултат жана адамга кийин жазса болот үчүн тег "
"коёт."

#: apps/flows/portability/library.py:390
msgid "Answer when you are open"
msgstr "Ачык экениңизди билдирүү"

#: apps/flows/portability/library.py:391
msgid "Answers “are you open?” with the real answer for the day it is asked."
msgstr "«Ачыксызбы?» дегенге суроо берилген күнгө ылайык чыныгы жооп берет."

#: apps/flows/portability/library.py:395
msgid "Check an order"
msgstr "Буйрутманы текшерүү"

#: apps/flows/portability/library.py:396
msgid "Asks for the order number, looks it up, and says where it is."
msgstr "Буйрутма номерин сурайт, аны издейт жана кайда экенин айтат."

#: apps/flows/schema/jsonschema.py:135
#, python-format
msgid "Expected %(types)s."
msgstr "%(types)s күтүлөт."

#: apps/flows/schema/jsonschema.py:143
#, python-format
msgid "Must be %(value)r."
msgstr "%(value)r болушу керек."

#: apps/flows/schema/jsonschema.py:149
#, python-format
msgid "Must be one of: %(options)s."
msgstr "Төмөнкүлөрдүн бири болушу керек: %(options)s."

#: apps/flows/schema/jsonschema.py:178
#, python-format
msgid "Too short: %(count)s character at least."
msgid_plural "Too short: %(count)s characters at least."
msgstr[0] "Өтө кыска: жок дегенде %(count)s символ болушу керек."

#: apps/flows/schema/jsonschema.py:183
#, python-format
msgid "Too long: %(count)s character at most."
msgid_plural "Too long: %(count)s characters at most."
msgstr[0] "Өтө узун: көп дегенде %(count)s символ болушу керек."

#: apps/flows/schema/jsonschema.py:188
msgid "Does not match the required format."
msgstr "Талап кылынган форматка дал келбейт."

#: apps/flows/schema/jsonschema.py:198
#, python-format
msgid "Must be at least %(minimum)s."
msgstr "Жок дегенде %(minimum)s болушу керек."

#: apps/flows/schema/jsonschema.py:202
#, python-format
msgid "Must be at most %(maximum)s."
msgstr "Көп дегенде %(maximum)s болушу керек."

#: apps/flows/schema/jsonschema.py:215
#, python-format
msgid "Add at least %(minimum)s more."
msgstr "Жок дегенде дагы %(minimum)s кошуңуз."

#: apps/flows/schema/jsonschema.py:218
#, python-format
msgid "%(maximum)s at most."
msgstr "Көп дегенде %(maximum)s."

#: apps/flows/schema/jsonschema.py:240
#, python-format
msgid "%(name)r is required."
msgstr "%(name)r милдеттүү."

#: apps/flows/schema/jsonschema.py:252
#, python-format
msgid "%(name)r is not a recognised key here. Allowed: %(allowed)s."
msgstr "%(name)r бул жерде белгисиз ачкыч. Уруксат берилгендер: %(allowed)s."

#: apps/flows/schema/jsonschema.py:253
msgid "none"
msgstr "жок"

#: apps/flows/schema/jsonschema.py:300
#, python-format
msgid "Matches %(matched)s of the allowed alternatives; exactly one may apply."
msgstr ""
"Уруксат берилген варианттардын %(matched)s'ине дал келет; так бирөө гана дал "
"келиши керек."

#: apps/flows/schema/jsonschema.py:324
#, python-format
msgid "%(prop)r is required."
msgstr "%(prop)r милдеттүү."

#: apps/flows/schema/jsonschema.py:328
#, python-format
msgid "Must be one of: %(allowed)s."
msgstr "Төмөнкүлөрдүн бири болушу керек: %(allowed)s."

#: apps/flows/schema/validation.py:131
msgid ""
"A connection points at a step that is not in this flow any more. Delete the "
"connection and draw it again."
msgstr ""
"Байланыш бул флоудо жок болуп калган кадамды көрсөтүп жатат. Байланышты "
"өчүрүп, кайра тартыңыз."

#: apps/flows/schema/validation.py:145
msgid ""
"A note is connected to something. Notes are there for you to read and take "
"no part in what the flow does, so delete the connection."
msgstr ""
"Эскертме бир нерсе менен туташтырылган. Эскертмелер окуу үчүн гана, флоунун "
"иштешине катышпайт, андыктан байланышты өчүрүңүз."

#: apps/flows/schema/validation.py:159
msgid ""
"This step ends the flow, so nothing joined after it can ever run. Delete the "
"connection leaving it."
msgstr ""
"Бул кадам флоуну аяктайт, андыктан андан кийин туташтырылган эч нерсе эч "
"качан иштебейт. Андан чыккан байланышты өчүрүңүз."

#: apps/flows/schema/validation.py:173
msgid ""
"A connection leaves this step by a path that does not exist. Delete it and "
"draw it again."
msgstr "Байланыш бул кадамдан жок жол менен чыгат. Аны өчүрүп, кайра тартыңыз."

#: apps/flows/schema/validation.py:187
msgid ""
"A connection leaves this step by a path it no longer has, usually because "
"the button or the option it followed was removed. Delete the connection and "
"draw it again."
msgstr ""
"Байланыш бул кадамдан мурда болгон, азыр жок жол менен чыгат — көбүнчө ал "
"байланган баскыч же вариант өчүрүлгөндүктөн. Байланышты өчүрүп, кайра "
"тартыңыз."

#: apps/flows/schema/validation.py:203
msgid ""
"Two connections leave this step the same way, and only one of them will be "
"followed. Delete the one you do not want."
msgstr ""
"Бул кадамдан бир эле жол менен эки байланыш чыгат, бирок алардын бири гана "
"иштейт. Керексизин өчүрүңүз."

#: apps/flows/schema/validation.py:284
#, python-format
msgid ""
"A button and a quick reply on this step are both called %(reply_id)r. A "
"reply only carries the name, so the flow cannot tell which one was tapped. "
"Rename one."
msgstr ""
"Бул кадамдагы баскыч менен тез жооп бирдей аталат — %(reply_id)r. Жооп "
"болгону атын гана алып жүрөт, андыктан флоу кайсынысы басылганын биле "
"албайт. Бирин башкача атаңыз."

#: apps/flows/schema/validation.py:332
msgid "This flow has no steps yet, so there is nothing to run. Add one."
msgstr ""
"Бул флоудо азырынча кадамдар жок, андыктан иштете турган эч нерсе жок. Кадам "
"кошуңуз."

#: apps/flows/schema/validation.py:341
msgid ""
"Every step follows another one, so there is nowhere for the flow to begin. "
"One step has to have nothing pointing into it: find the connection that "
"loops back to the step you want first, and delete it."
msgstr ""
"Ар бир кадам башка кадамдан кийин келет, андыктан флоу баштала турган жер "
"жок. Бир кадамга эч нерсе кирбеши керек: биринчи болушун каалаган кадамга "
"кайра кайтып келген байланышты табыңыз жана өчүрүңүз."

#: apps/flows/schema/validation.py:353
#, python-format
msgid ""
"%(count)s step has nothing pointing into it, so it is not clear where this "
"flow begins. Exactly one may. Join the others up, or delete them."
msgid_plural ""
"%(count)s steps have nothing pointing into them, so it is not clear where "
"this flow begins. Exactly one may. Join the others up, or delete them."
msgstr[0] ""
"%(count)s кадамга эч нерсе киришпейт, ошондуктан флоу кайдан башталарын "
"билүү мүмкүн эмес. Так бир гана кадам мындай болушу керек. Калгандарын "
"бириктириңиз же өчүрүңүз."

#: apps/flows/schema/validation.py:402
msgid ""
"Nothing leads to this step, so it will never run. Join it up, or delete it."
msgstr ""
"Бул кадамга эч нерсе алып келбейт, андыктан ал эч качан иштебейт. Аны "
"бириктириңиз же өчүрүңүз."

#: apps/flows/schema/validation.py:436
#, python-format
msgid ""
"This step sends over %(platform)s, and no %(platform)s account is connected "
"here."
msgstr ""
"Бул кадам %(platform)s аркылуу жөнөтөт, бирок бул жерге %(platform)s "
"аккаунту туташтырылган эмес."

#: apps/flows/schema/validation.py:462
#, python-format
msgid ""
"%(platform)s cannot show %(block_type)s properly. It will be sent in a "
"simpler form."
msgstr ""
"%(platform)s %(block_type)s'ти туура көрсөтө албайт. Бул жөнөкөйлөтүлгөн "
"түрдө жөнөтүлөт."

#: apps/flows/schema/validation.py:471
#, python-format
msgid ""
"%(platform)s cuts messages off at %(limit)s characters and this one is "
"%(length)s."
msgstr ""
"%(platform)s билдирүүлөрдү %(limit)s символдон кыркат, ал эми бул билдирүү "
"%(length)s."

#: apps/flows/schema/validation.py:484
#, python-format
msgid ""
"%(platform)s shows buttons or quick replies, not both. The quick replies "
"will arrive as a numbered list at the end of the message instead."
msgstr ""
"%(platform)s баскычтарды же тез жоопторду көрсөтөт, экөөнү тең эмес. Тез "
"жооптор билдирүүнүн аягында номерленген тизме түрүндө келет."

#: apps/flows/schema/validation.py:493
msgid "buttons"
msgstr "баскычтар"

#: apps/flows/schema/validation.py:494
msgid "quick replies"
msgstr "тез жооптор"

#: apps/flows/schema/validation.py:503
#, python-format
msgid ""
"%(platform)s does not support %(label)s. They will be added to the end of "
"the message as text instead."
msgstr ""
"%(platform)s %(label)s колдобойт. Алар билдирүүнүн аягына текст катары "
"кошулат."

#: apps/flows/schema/validation.py:512
#, python-format
msgid "%(platform)s allows %(ceiling)s %(label)s and this step has %(count)s."
msgstr ""
"%(platform)s %(ceiling)s %(label)s гана уруксат берет, ал эми бул кадамда "
"%(count)s бар."

#: apps/flows/schema/validation.py:523
#, python-format
msgid ""
"%(platform)s has no link buttons; the URL is appended to the text instead."
msgstr "%(platform)s шилтеме баскычтарын колдобойт; URL текстке кошулат."

