msgid "Sent outside the window under an approved message tag."
msgstr "Терезеден тышкары, бекитилген билдирүү тегин колдонуп жөнөтүлдү."

#: apps/messaging/codes.py:103
msgid "Sent outside the window using an approved template."
msgstr "Терезеден тышкары, бекитилген үлгүнү колдонуп жөнөтүлдү."

#: apps/messaging/codes.py:104
msgid "This contact opted out of messages on this channel."
msgstr "Бул байланыштагы адам бул каналдагы билдирүүлөрдөн баш тартты."

