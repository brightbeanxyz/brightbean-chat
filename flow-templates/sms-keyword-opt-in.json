            "position": {
              "x": 0,
              "y": 0
            },
            "type": "send_message"
          },
          {
            "config": {
              "question": "What name should we use?",
              "reply_type": "text",
              "retry": {
                "max": 1
              },
              "target": {
                "key": "first_name",
                "type": "system_field"
              },
              "timeout": {
                "delay": 1,
                "enabled": true,
                "unit": "days"
              }
            },
            "id": "ask_name",
