            "type": "data_collection"
          },
          {
            "config": {
              "actions": [
                {
                  "tag": "SMS subscriber",
                  "verb": "add_tag"
                },
                {
                  "field": "Signup source",
                  "value": "SMS keyword",
                  "verb": "set_field"
                }
              ]
            },
            "id": "record",
            "position": {
              "x": 600,
              "y": 0
            },
            "type": "action"
          },
          {
            "config": {
              "blocks": [
                {
                  "text": "Thanks {{first_name}} - you are all set.",
                  "type": "text"
                }
              ]
            },
            "id": "welcome",
            "position": {
              "x": 900,
              "y": 0
            },
            "type": "send_message"
          }
        ],
        "schema": 1
      },
      "key": "flow-1",
      "name": "SMS keyword opt-in",
