# Production environment for docker-compose.prod.yml.
#
#   cp deploy/env.prod.example .env      # compose reads ./.env for interpolation
#   make prod-secrets                    # generates the four values below
#   $EDITOR .env
#
# Every value in the REQUIRED block is empty on purpose. `docker compose -f
# docker-compose.prod.yml up` refuses to start while any of them is unset and
# names the one it is missing — a wrong-but-present placeholder would boot, and
# a deployment signing sessions with a string published in this repository is
# the failure this file exists to prevent (SECURITY-BASELINE §8).
#
# Full walkthrough: docs/self-hosting.md. Every optional variable this app
# understands is documented in .env.example at the repo root; this file carries
# the subset a production deployment actually decides.

# ---------------------------------------------------------------------------
# REQUIRED — the stack will not start until all five are set
# ---------------------------------------------------------------------------

# The one hostname this deployment answers on, without a scheme. It configures
# Caddy's certificate, Django's ALLOWED_HOSTS and the APP_URL that public links
# (unsubscribe, click tracking, media delivery) are built from. Its DNS record
# must already point at this host before the first `up`, or the certificate
# cannot be issued.
APP_DOMAIN=

# Where Let's Encrypt sends expiry and problem notices for that certificate.
ACME_EMAIL=

# Django's signing key, and the input to credential encryption.
SECRET_KEY=

# The HKDF salt for the AES-256-GCM encrypted fields. A DIFFERENT random value
# from SECRET_KEY.
#
# Back both of these up somewhere other than the database. A dump contains the
# encrypted platform credentials; these two are what decrypt them. Lose them and
# every stored credential is unreadable — see docs/self-hosting.md § Backups.
ENCRYPTION_KEY_SALT=

# The password for the bundled Postgres. It ends up inside a URL, so keep it
# URL-safe — `make prod-secrets` generates one that is.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Only when this deployment answers on more than one name, or when APP_URL must
# differ from https://$APP_DOMAIN. Both default to APP_DOMAIN.
# ALLOWED_HOSTS=chat.example.com,www.example.com
# APP_URL=https://chat.example.com

# The bundled Postgres. Change these before the FIRST start — afterwards the
# database is already initialised with the old values and changing them here
# only breaks the connection string.
# POSTGRES_DB=brightbean_chat
# POSTGRES_USER=brightbean

# Point the app at a managed Postgres instead of the bundled one. Setting this
# wins over the URL assembled from POSTGRES_*.
# DATABASE_URL=

# Which image tag the stack runs. `IMAGE_TAG=v1.4.0 docker compose -f
# docker-compose.prod.yml up -d` is the upgrade step in docs/self-hosting.md.
# IMAGE_TAG=latest

# For a host that already has something on 80/443 and forwards to these. Note
# that automatic HTTPS needs port 80 reachable from the internet for the ACME
# challenge, so changing these means terminating TLS elsewhere — see
# deploy/docker-compose.external-tls.yml.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# Which peers may speak for someone else via X-Forwarded-For. Defaults to
# Docker's own bridge range, which is Caddy — the only thing that can reach the
# app. Widen it only if a second proxy sits in front of Caddy, and only to that
# proxy's address; the header is attacker-controlled otherwise and trusting it
# turns the auth rate limiting off.
# TRUSTED_PROXIES=172.16.0.0/12

# The shared secret for /internal/tick, an HTTP wrapper around one worker cycle.
# The compose stack runs a real worker, so leave this EMPTY unless you also want
# a cron service or uptime pinger to be able to drain the queue. The route 404s
# while it is unset. Treat it as a credential.
# TICK_TOKEN=

# Platform app credentials — the deployment-level fallback in the resolution
# chain (workspace override -> organization -> here), plus the token Meta checks
# when you subscribe a webhook URL. See .env.example for the full list and
# docs/channels/ for where each value comes from.
# PLATFORM_INSTAGRAM_CLIENT_ID=
# PLATFORM_INSTAGRAM_CLIENT_SECRET=
# PLATFORM_INSTAGRAM_VERIFY_TOKEN=

# SMTP, for password reset and email verification. Without it those messages
# cannot be delivered; nothing else is gated on them.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@example.com

# Error reporting. Empty disables Sentry entirely.
# SENTRY_DSN=

# DEBUG is deliberately absent. config/settings/production.py forces it off
# before it loads anything else, so a stray DEBUG=true here changes nothing —
# which is the point.
