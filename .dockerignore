# Keep the build context small and keep secrets, caches and build artefacts
# out of the image entirely. Studio has no .dockerignore at all, so its image
# carries .git and any local .env.
.git
.github
.gitignore
.dockerignore
.pre-commit-config.yaml

# Secrets and local environment
.env
.env.*
!.env.example

# Python caches and virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Build artefacts and local data
staticfiles/
media/
test_media/
node_modules/
# Compiled by the `frontend` stage and COPYed into the runtime stage. Excluding
# it here keeps a developer's stale local build out of the image entirely,
# rather than relying on the later COPY to overwrite it.
theme/static/css/dist/
apps/flows/static/flows/builder/

# Not needed at runtime
docs/
tests/
conftest.py
requirements-dev.in
requirements-dev.txt
Makefile
docker-compose*.yml
LICENSE
README.md
SECURITY.md
.DS_Store

# Deployment configuration (issue #28). These describe how to RUN the image;
# none of them belongs inside it. deploy/ in particular holds the Caddyfile,
# which is bind-mounted into the caddy container from the host, and the
# production env template.
deploy/
app.json
render.yaml
railway.json
scripts/smoke.sh
